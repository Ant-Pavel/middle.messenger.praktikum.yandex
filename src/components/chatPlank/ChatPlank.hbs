<li class="chat__item chatCard" data-dataId="{{ id }}">
    {{#if avatar}}
        <img class="chatCard__image" width="50" height="50" src="{{avatar}}" alt="chat image">
    {{else}}
        <div class="chatCard__imageDummy"></div>
    {{/if}}
    <div class="chatCard__info">
        <div class="chatCard__top">
            <p class="chatCard__name">{{ title }}</p>
            <span class="chatCard__time">{{ lastMsgTime }}</span>
        </div>
        <div class="chatCard__bottom">
            <p class="chatCard__lastMsg">{{{ lastMsgContent }}}</p>
            {{#if unread_count}}
            <div class="chatCard__unreadAmount"><span>{{ unread_count }}</span></div>
            {{/if}}
        </div>
    </div>
</li>
