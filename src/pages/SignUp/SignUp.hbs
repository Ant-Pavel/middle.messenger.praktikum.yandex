<div class="signUp__page">
    <main class="signUp__container">
        <div class="form__wrap">
            <h1 class="form__title">Регистрация</h1>
            <form class="signUp__form form" data-forEventName="formElement">
                {{{ formControls }}}
                <div class="form__buttonWrap">
                    {{{ button }}}
                </div>
                <div class="signUp__message">{{ hint }}</div>                
                <div class="form__action">
                    {{{ enterLink }}}
                </div>
            </form>
        </div>
    </main>
</div>
